include LICENSE README.md PLUGIN_API.md CONTRIBUTING.md SECURITY.md THIRD_PARTY_NOTICES.md RELEASING.md VALIDATION.md COMPATIBILITY.md
recursive-include src *.py *.toml
recursive-include tests *.py *.json
recursive-include examples *.py *.json *.md *.toml
recursive-include scripts *.ps1
recursive-include tools *.py
recursive-include tools/recognizer_eval *.json *.md *.in *.lock
include docs/CLI-INSTALL.md
include docs/MAC-CLI-QUALIFICATION.md
include docs/recognizer-coverage.md
include docs/recognizer-evaluation.md docs/recognizer-results.json
recursive-include native/scan_walk *.rs *.md Cargo.toml Cargo.lock
prune native/scan_walk/target
recursive-include .github *.yml
global-exclude __pycache__ *.py[cod]
